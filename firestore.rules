rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // O administrador é identificado pelo e-mail da conta do Firebase Auth.
    // Para trocar de conta, altere o e-mail abaixo e reimplante as regras.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'pedrohenriquealmeida2004@gmail.com';
    }

    // Conteúdo do portfólio: leitura pública (o site é público),
    // escrita apenas para o administrador autenticado.
    match /portfolio_data/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio_images/{imageName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documento legado com a senha em texto puro. A aplicacao nao usa mais
    // essa colecao — bloqueada por completo ate ser removida do banco.
    match /portfolio_settings/{docId} {
      allow read, write: if false;
    }

    // Nada mais e acessivel.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
